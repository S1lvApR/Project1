# ═══════════════════════════════════════════════════════
# 基于 YOLOv11 的⽬标检测智能体平台 — 环境变量配置
# ═══════════════════════════════════════════════════════
# ── AI 供应商配置 ──────────────────────────────────────
# 可选值: openai, baidu, doubao, qianwen, bailian
AI_PROVIDER=bailian
# ── OpenAI API 配置 ───────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# ── 豆包 API 配置 ──────────────────────────────────────
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-3.5
# ── 通义千问 API 配置 ──────────────────────────────────
QIANWEN_API_KEY=your-qianwen-api-key
QIANWEN_MODEL=qwen2-72b-instruct
# ── 阿里云百炼 API 配置 ──────────────────────────────────
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen2.5-7b-instruct
# ── 数据库配置 ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-username
DB_PASSWORD=your-database-password
# ── Redis 配置 ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# 开发环境：本地 Docker
DATABASE_URL=postgresql://your-database-username:your-databasepassword@localhost:5432/your-database-name
# ⽣产环境：取消下⼀⾏的注释并注释掉上⾯的⾏
# DATABASE_URL=postgresql://your-database-username:your-secure-password@yourhost:5432/your-database-name
# ── 本地 LLM 配置（可选）────────────────────
USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# ── Redis 配置 ───────────────────────────────────────
# 开发环境：本地 Docker
REDIS_URL=redis://localhost:6379/0
# ⽣产环境：取消下⼀⾏的注释并注释掉上⾯的⾏
# REDIS_URL=redis://:your-redis-password@your-redis-host:6379/0
# ── MinIO 对象存储配置 ───────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=L-images
MINIO_SECURE=false
# ── JWT 认证配置 ─────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# ── 百度OCR API 配置 ──────────────────────────────
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
# ── 应⽤配置 ─────────────────────────────────────────
APP_NAME=L Agent Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
# ── SignAnalyzer 智能体配置 ────────────────────────
SIGN_ANALYZER_API_KEY=your-sign-analyzer-api-key
SIGN_ANALYZER_API_URL=https://api.example.com/sign-analyzer
# ── CORS 配置 ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173