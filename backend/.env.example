# ═══════════════════════════════════════════════════════
# 基于 YOLOv11 的目标检测智能体平台 — 环境变量配置模板
# ═══════════════════════════════════════════════════════
# 复制此文件为 .env 并填写真实配置值
# .env 文件已被 .gitignore 忽略，不会被提交到版本控制

# ── 应用基础配置 ──────────────────────────────────────
APP_NAME=L Agent Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
APP_MODE=local

# ── 数据库配置 ────────────────────────────────────────
# 本地开发环境（SQLite）
DATABASE_URL=sqlite:///./data/local.db
# 生产环境（PostgreSQL）- 取消注释并配置
# DATABASE_URL=postgresql://username:password@host:5432/database_name
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-username
DB_PASSWORD=your-database-password

# ── Redis 配置 ────────────────────────────────────────
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── MinIO 对象存储配置 ────────────────────────────────
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=L-images
MINIO_SECURE=false

# ── 本地 YOLO 推理配置 ────────────────────────────────
YOLO_MODEL_PATH=../models/tt100k-yolo11s-reference42.pt
YOLO_MODEL_NAME=tt100k-yolo11s-reference42
YOLO_MODEL_TYPE=yolov11s
YOLO_DEVICE=cpu
YOLO_CANONICALIZE_TT100K_CLASSES=true
YOLO_USE_SAHI=false
YOLO_SAHI_SLICE_HEIGHT=512
YOLO_SAHI_SLICE_WIDTH=512
YOLO_SAHI_OVERLAP_RATIO=0.2
YOLO_SAHI_MODEL_IMAGE_SIZE=640
YOLO_SAHI_STANDARD_PREDICTION=true
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
YOLO_IMAGE_SIZE=1280

# ── 视频检测配置 ──────────────────────────────────────
VIDEO_MAX_BYTES=52428800
VIDEO_FRAME_SAMPLE_RATE=5
VIDEO_MAX_FRAMES=500
VIDEO_WORKERS=2
VIDEO_MAX_PENDING_TASKS=4
VIDEO_PROGRESS_TTL_SECONDS=3600
VIDEO_TEMP_DIR=./uploads/videos
VIDEO_STATUS_DIR=./data/video_status

# ── 摄像头检测配置 ────────────────────────────────────
CAMERA_CPU_IMAGE_SIZE=416
CAMERA_GPU_IMAGE_SIZE=640
CAMERA_MAX_FRAME_BYTES=2097152

# ── GTSRB 分类器配置 ──────────────────────────────────
GTSRB_MODEL_PATH=../models/gtsrb-yolo11n-cls.pt
GTSRB_DEVICE=cpu
GTSRB_IMAGE_SIZE=128
GTSRB_CROP_MAX_DIMENSION=512

# ── JWT 认证配置（敏感）───────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── 百炼智能体配置（敏感）─────────────────────────────
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo

# ── 通义千问 API 配置（敏感）─────────────────────────
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# ── 通义千问 Embedding 配置（RAG 使用）──────────────────
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ── OpenAI API 配置（可选，敏感）──────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 百度OCR API 配置（可选，敏感）─────────────────────
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# ── CORS 配置 ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ── RAG / Embedding 配置 ─────────────────────────────
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3